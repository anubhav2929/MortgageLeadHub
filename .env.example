# Copy to .env.local and fill in whichever providers you're ready to go live
# with. Every key below is optional — leave any of them blank and that
# channel keeps running in simulated mode (visible in the DEMO banner and in
# server logs on boot). No code changes are needed either way.
#
# DATABASE_URL is the one exception: it's optional for local dev (falls back
# to a JSON file in .data/) but REQUIRED before deploying to Vercel — without
# it, every cold start resets to seed data and concurrent instances won't
# share leads. The app also accepts Vercel Postgres' POSTGRES_URL automatically.
# See DEPLOY.md.

# Postgres (Vercel Postgres / Neon) — persists the CRM data store. Leave
# blank locally to use the .data/db.json file fallback instead.
DATABASE_URL=

# Required to manage provider API keys from Admin → Integrations. Keys are
# encrypted before they're written to the database, and the root key that
# decrypts them cannot live beside them — so this one stays an env var.
# Generate with: openssl rand -hex 32
# Without it, the Integrations panel is read-only and providers must be
# configured through the env vars below instead.
CREDENTIAL_SECRET=

# Telnyx — preferred SMS/voice provider when set (roughly half Twilio's
# per-segment cost, native 10DLC registration — see DEPLOY.md). Get these
# from portal.telnyx.com: API key under Auth > API Keys, phone number under
# Numbers, messaging profile ID under Messaging (optional — only needed if
# your number isn't already assigned to a default profile).
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Telnyx VOICE only (SMS needs neither). TeXML fetches the call script from a
# URL instead of taking it inline the way Twilio does, so calls also require
# DELIVERY_WEBHOOK_SECRET to be set. Portal -> Voice -> TeXML Applications.
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=

# Twilio — SMS/voice fallback when Telnyx isn't configured (Call now / Text
# actions in the officer workspace). Get these from console.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic — powers real structured extraction from conversation transcripts
# (Conversation tab → "Run AI extraction"), AI-generated call scripts and
# follow-up emails (Call now / Email actions), and lead discovery intent
# classification. Get this from console.anthropic.com.
ANTHROPIC_API_KEY=

# NVIDIA NIM (build.nvidia.com) — free-tier alternative to Anthropic for the
# "AI messaging" functions only (outreach call/email/SMS drafts, and Reddit
# signal replies) — extraction/classification still needs ANTHROPIC_API_KEY.
# If ANTHROPIC_API_KEY is set, that's used instead; NVIDIA is the fallback
# free option when it's not. Get a free API key at build.nvidia.com (sign in,
# pick any chat model, click "Get API Key").
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Resend — powers real outbound email sends.
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@yourdomain.com

# Resend inbound email — borrower replies to outreach emails get matched to
# their lead and turned into a task (see domain/inboundEmail.ts). Requires:
#   1. A receiving domain/address set up under Resend > Receiving.
#   2. A webhook in Resend > Webhooks for the `email.received` event,
#      pointed at https://yourdomain.com/api/webhooks/resend-inbound
#   3. RESEND_INBOUND_WEBHOOK_SECRET below, set to that webhook's signing
#      secret (starts with whsec_) — without it this stays off (401s).
RESEND_INBOUND_WEBHOOK_SECRET=

# Voice AI agent (SPEC.md F-05) — live conversational qualification calls via
# Vapi (vapi.ai). All three are required together to go live (the "AI call"
# button in the lead detail workspace simulates otherwise):
#   VAPI_API_KEY          — from your Vapi dashboard
#   VAPI_PHONE_NUMBER_ID  — a number you've provisioned or imported (BYO
#                           Twilio number) in Vapi; this is Vapi's internal
#                           id for that number, not the phone number itself
#   VAPI_WEBHOOK_SECRET   — any random string you generate; Vapi echoes it
#                           back in the x-vapi-secret header on every call
#                           to /api/webhooks/vapi so that route can verify
#                           the request really came from Vapi
# See src/adapters/voiceAgent.ts and src/app/api/webhooks/vapi/route.ts.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# Not wired up — Retell would need its own adapter/webhook, structured the
# same way; only Vapi is implemented today.
RETELL_API_KEY=

# Lead discovery — searches public Reddit posts for refinance/equity intent
# (Lead Discovery page). Create a "script" app at reddit.com/prefs/apps to get
# a client ID and secret; no user login is needed, just app-only auth.
# Discovered posts always land in a human review queue — see
# src/adapters/leadDiscovery.ts and src/domain/actions.ts (promoteSignalToLeadAction)
# for why nothing here auto-contacts anyone.
# Lead discovery needs no credentials — it reads a public archive. See docs/adr/0006.

# Property AVM enrichment — see src/adapters/propertyData.ts. Vendor:
# RentCast (rentcast.io) — the only AVM provider with a real, no-credit-card
# free tier (50 requests/month) an individual developer can sign up for.
# Zillow's Zestimate API has been closed to the public since 2021
# (enterprise/MLS-only); CoreLogic/ATTOM/HouseCanary are enterprise-sales-only.
# Get a free key at rentcast.io/app -> API tab (no card required). Live
# lookups only fire for leads where the borrower gave a street address
# (see the intake form's optional "Street address" field) — without one,
# this still simulates, both because a bare "city, state" can't identify a
# specific property and to avoid burning the 50/month cap on a low-quality
# lookup. Each unique lead is only ever looked up once and cached on the
# lead record (src/domain/queries.ts getOrCachePropertyValuation), not
# re-fetched on every page view.
PROPERTY_DATA_API_KEY=

# Supabase's root CA certificate, required when DATABASE_URL / POSTGRES_URL
# points to Supabase. Paste the full PEM (including BEGIN/END lines) in Vercel.
# Get it from Supabase → Database → Settings → SSL Configuration.
SUPABASE_CA_CERT=

# Protects /api/cron/cadence, the automated cadence engine's trigger
# endpoint (src/domain/cadenceEngine.ts) — set this and configure your
# scheduler (Vercel Cron in vercel.json, or an external pinger) to send
# `Authorization: Bearer <this value>`. REQUIRED in production — the route
# fails closed (401) without it there; only local dev leaves it unprotected
# when unset.
CRON_SECRET=

# Your real NMLS ID, shown in the public site footer
# (src/components/marketing/mkt-footer.tsx). Leave unset and the footer
# visibly reads "SET_COMPANY_NMLS_ID" rather than a fake-looking placeholder
# number — set this before sharing the site publicly.
COMPANY_NMLS_ID=

# Public base URL of this deployment — used to build links in emails
# (account invites, password resets) and the Vapi webhook callback URL.
# Leave blank on Vercel: falls back to the auto-populated VERCEL_URL. Set
# explicitly if you're on a custom domain.
APP_URL=

# GA4 measurement ID (format: G-XXXXXXXXXX). Leave unset and no analytics
# script loads at all — see src/components/layout/google-analytics.tsx.
# Must be prefixed NEXT_PUBLIC_ to reach the browser; Next.js inlines it at
# build time, so redeploy after changing it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Authenticates provider delivery callbacks (src/app/api/webhooks/delivery).
# Until this is set the app does not request delivery receipts at all, so an
# outbound text or call stays "sent" forever and a carrier rejection — wrong
# number, landline, spam-filtered, 10DLC unregistered — is never noticed.
# Generate with: openssl rand -hex 32
DELIVERY_WEBHOOK_SECRET=

# Resend's signing secret for delivery events (email.sent / email.delivered /
# email.bounced). Separate from RESEND_INBOUND_WEBHOOK_SECRET, which is for
# received replies. Without it, a bounced email looks identical to a
# delivered one.
RESEND_WEBHOOK_SECRET=

# iSoftpull — soft credit inquiry at the pre-qualification gate. Billed per
# inquiry, so the app only fires one after the borrower explicitly authorises
# it (FCRA) and never more than once per lead. See src/core/creditGate.ts.
ISOFTPULL_API_KEY=
ISOFTPULL_API_SECRET=
