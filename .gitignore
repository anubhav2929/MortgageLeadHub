# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, but the template must, since
# DEPLOY.md sends you to it for the full env var list.
.env*
!.env.example

# vercel
.vercel

# local mock-store snapshot (persistence.ts) — demo data, not source
/.data/
/.backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / assistant tooling — local developer config, not product source
/.claude/
*.code-workspace

# internal working notes and client collateral. Kept on disk for whoever needs
# them, deliberately out of the source tree: point-in-time meeting notes and
# commercial documents are not maintained artifacts and go stale silently.
/docs/internal/
